<root>
	<!--
		个性化服务端配置({assets}/res/server/kbengine.xml)

		如果你需要改变引擎设置, 请在({assets}/res/server/kbengine.xml)中覆盖kbe/res/server/kbengine_defaults.xml的对应参数来修改, 
		这样的好处是不会破坏引擎的默认设置，在你更新引擎时也不会产生冲突，以及在多个逻辑项目时不会影响到其他的项目设置。
		详细说明请参考：http://kbengine.org/cn/docs/configuration/kbengine.html
	-->
	
	<trace_packet>
		<debug_type> 0 </debug_type>
	</trace_packet>
	
	<publish>
		<!-- 发布状态, 可在脚本中获取该值。 KBEngine.publish()
			(apps released state, This value can be obtained in the script. KBEngine.publish())
			Type: Integer8
			0 : debug
			1 : release
			其他自定义(Other custom)
		-->
		<state> 0 </state>

		<!-- 脚本层发布的版本号
			(Script layer released version number)
		 -->
		<script_version> 0.1.0 </script_version>
	</publish>
	
	<!-- defined => kbe/res/server/kbengine_defs.xml -->
	<dbmgr>
		<account_system>
			<!-- 账号找回密码相关
				(Account reset password)
			-->
			<account_resetPassword>
				<!-- 是否开放重设密码
					(Whether open reset password)
				-->
				<enable>	true	</enable>
			</account_resetPassword>
			
			<!-- 账号注册相关
				(Account registration)
			-->
			<account_registration> 
				<!-- 是否开放注册 
					(Whether open registration)
				-->
				<enable>	true	</enable>
				
				<!-- 登录合法时游戏数据库找不到游戏账号则自动创建 
					(When logged in, the game database can not find the game account is automatically created)
				-->
				<loginAutoCreate> true </loginAutoCreate>
			</account_registration>
		</account_system>
		
		<databaseInterfaces>
			<default>
				<!-- <host> localhost </host> -->
				<!-- <databaseName> kbe </databaseName> -->
			</default>
		</databaseInterfaces>
	</dbmgr>
	
	<baseapp>
		<backupPeriod> 500 </backupPeriod>
	</baseapp>

	<!-- 集群(cluster, 可选)：默认直接使用引擎 kbengine_defaults.xml 的 <cluster> 段(单成员自举)。
		多副本高可用部署时，在所有服务器资产的该文件中填写相同的集群成员列表；
		列表顺序即副本成员序号(从0开始)，全部副本必须一致。示例：
	<cluster>
		<addresses>
			<item> 192.168.10.11 </item>
			<item> 192.168.10.12 </item>
			<item> 192.168.10.13 </item>
		</addresses>
	</cluster>

		单机三副本本地冒烟也可使用回环地址 127.0.0.1/127.0.0.2/127.0.0.3
		(Windows 需管理员执行 netsh interface ipv4 add address Loopback 127.0.0.2 255.0.0.0 等，
		 参见 kbe/src/server/cluster/smoke/assets_a/res/server/kbengine.xml):
	<cluster>
		<addresses>
			<item> 127.0.0.1 </item>
			<item> 127.0.0.2 </item>
			<item> 127.0.0.3 </item>
		</addresses>
	</cluster>
	-->
</root>